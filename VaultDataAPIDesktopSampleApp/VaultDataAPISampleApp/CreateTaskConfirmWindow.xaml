<Window x:Class="VaultDataAPISampleApp.CreateTaskConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Ext-Sync Task"
        Height="190"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="105"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="ConfigId:" VerticalAlignment="Center" Padding="0,0,6,0"/>
        <TextBox x:Name="ConfigIdTextBox"
                 Grid.Row="0"
                 Grid.Column="1"
                 Margin="0,0,0,8"
                 Height="24"
                 VerticalContentAlignment="Center"
                 IsReadOnly="True"
                 Background="#F5F5F5"/>

        <Label Grid.Row="1" Grid.Column="0" Content="WorkflowType:" VerticalAlignment="Center" Padding="0,0,6,0"/>
        <TextBox x:Name="WorkflowTypeTextBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 Margin="0,0,0,12"
                 Height="24"
                 VerticalContentAlignment="Center"
                 IsReadOnly="True"
                 Background="#F5F5F5"/>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="86" Height="24" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Create" Width="86" Height="24" IsDefault="True" Click="Create_Click"/>
        </StackPanel>
    </Grid>
</Window>
