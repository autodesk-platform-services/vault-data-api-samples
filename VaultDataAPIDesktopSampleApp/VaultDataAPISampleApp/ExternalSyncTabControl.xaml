<UserControl x:Class="VaultDataAPISampleApp.ExternalSyncTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0696D7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0580B5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#B0B0B0"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#999999"/>
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0580B5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#046A96"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="BorderBrush" Value="#C8C8C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F4F9FF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#8AB8E6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E6F2FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ZebraListViewItem" TargetType="ListViewItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F5F5F5"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CCE4F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CreateActionButton" TargetType="Button">
            <Setter Property="Background" Value="#107C10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0E6B0E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteActionButton" TargetType="Button">
            <Setter Property="Background" Value="#D13438"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B52B2F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResubmitActionButton" TargetType="Button">
            <Setter Property="Background" Value="#0696D7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0580B5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Vertical">
                <TextBlock x:Name="ExtSyncHintText" Margin="0,0,0,6" FontSize="12" Foreground="#D13438"
                           Text="Please configure external sync mapping in Vault Client first, then click 'Load Configs' to verify."/>
                <DockPanel Margin="0,0,0,6">
                    <Button Content="Load Configs" Click="LoadConfigs_Click" DockPanel.Dock="Left" Margin="0,0,8,0" Width="90" Height="26"
                            Style="{StaticResource PrimaryButton}"/>
                    <TextBox x:Name="ExtSyncConfigsText" Height="26" VerticalAlignment="Center" VerticalContentAlignment="Center"
                             IsReadOnly="True" Background="#F5F5F5" FontFamily="Courier New" FontSize="11" Foreground="#444444"/>
                </DockPanel>
                <WrapPanel x:Name="LoadItemsPanel" Orientation="Horizontal" IsEnabled="False">
                    <Button Content="Load Items" Click="LoadItems_Click" Margin="0,0,8,0" Width="90" Height="26"
                            Style="{StaticResource PrimaryButton}"/>
                    <Label Content="Limit:" VerticalAlignment="Center" Padding="0,0,4,0"/>
                    <TextBox x:Name="ItemListLimitInput" Width="50" Height="26" Margin="0,0,8,0" VerticalAlignment="Center" VerticalContentAlignment="Center" Text="50"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid x:Name="ExtSyncContentPanel" Grid.Row="1" Margin="8,4,8,4" IsEnabled="False" Opacity="0.5">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.3*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="2.7*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="Items" Padding="2">
                    <Grid>
                        <TextBlock x:Name="ItemsEmptyText"
                                   Text="Click 'Load Items' to get started."
                                   Foreground="#888888" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Visible"/>
                        <ListView x:Name="ItemsGrid" Background="Transparent" BorderBrush="{x:Null}"
                                  SelectionMode="Extended"
                                  AlternationCount="2"
                                  ItemContainerStyle="{StaticResource ZebraListViewItem}"
                                  SelectionChanged="ItemsGrid_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Number" DisplayMemberBinding="{Binding Number}" Width="160"/>
                                    <GridViewColumn Header="Revision" DisplayMemberBinding="{Binding Revision}" Width="55"/>
                                    <GridViewColumn Header="State" DisplayMemberBinding="{Binding State}" Width="100"/>
                                    <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}" Width="100"/>
                                    <GridViewColumn Header="Create Task" Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Create" ToolTip="Create Ext-Sync Task"
                                                        Click="CreateTaskButton_Click"
                                                        Style="{StaticResource CreateActionButton}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </GroupBox>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#CCCCCC"/>

                <GroupBox Grid.Column="2" Padding="2">
                    <GroupBox.Header>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Sync Info" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button x:Name="RefreshSyncInfoButton"
                                    DockPanel.Dock="Right"
                                    Margin="8,0,0,0"
                                    IsEnabled="False"
                                    ToolTip="Refresh selected item's sync info"
                                    Click="RefreshSyncInfoButton_Click"
                                    Style="{StaticResource IconButton}">
                                <TextBlock x:Name="RefreshSyncInfoIcon"
                                           Text="&#xE72C;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Button>
                        </DockPanel>
                    </GroupBox.Header>
                    <Grid>
                        <TextBlock x:Name="SyncInfoEmptyText"
                                   Text="Select an item to view sync info."
                                   Foreground="#888888" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Visible"/>
                        <Grid x:Name="SyncInfoCardsPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="SyncInfoStatusRow" Height="Auto"/>
                                <RowDefinition x:Name="SyncInfoSpacerRow" Height="8"/>
                                <RowDefinition x:Name="SyncInfoDetailsRow" Height="*"/>
                            </Grid.RowDefinitions>

                            <Border x:Name="SyncInfoStatusCard" Grid.Row="0" Padding="10" CornerRadius="4" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="1" Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="SyncInfoStatusNameText" FontWeight="SemiBold" FontSize="15" Foreground="#1A1A1A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border x:Name="SyncInfoStatusBadge" Background="#E5E7EB" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="10" Padding="8,2" Visibility="Collapsed">
                                                <TextBlock x:Name="SyncInfoStatusBadgeText" FontSize="11" FontWeight="SemiBold" Foreground="#374151"/>
                                            </Border>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#F1F1F1" BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="10" Padding="8,2">
                                            <TextBlock x:Name="SyncInfoStatusCreateText" Foreground="#555555" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                    <Border Grid.Row="1" Background="#F6F8FB" BorderBrush="#E0E6EF" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="0,0,0,8" HorizontalAlignment="Left">
                                        <TextBlock x:Name="SyncInfoStatusParentText" Foreground="#4A5568" FontSize="11"/>
                                    </Border>
                                    <Border Grid.Row="2" Background="#F7F9FC" BorderBrush="#D9E0EA" BorderThickness="1" Padding="8" CornerRadius="3">
                                        <TextBlock x:Name="SyncInfoStatusValueText" Foreground="#1F2937" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="SyncInfoDetailsCard" Grid.Row="2" Padding="10" CornerRadius="4" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="1" Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SyncInfoDetailsNameText" Grid.Column="0" FontWeight="SemiBold" FontSize="15" Foreground="#1A1A1A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                        <Border Grid.Column="1" Background="#F1F1F1" BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="10" Padding="8,2">
                                            <TextBlock x:Name="SyncInfoDetailsCreateText" Foreground="#555555" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                    <Border Grid.Row="1" Background="#F6F8FB" BorderBrush="#E0E6EF" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="0,0,0,8" HorizontalAlignment="Left">
                                        <TextBlock x:Name="SyncInfoDetailsParentText" Foreground="#4A5568" FontSize="11"/>
                                    </Border>
                                    <Border Grid.Row="2" Background="#F7F9FC" BorderBrush="#D9E0EA" BorderThickness="1" Padding="8" CornerRadius="3">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <TextBlock x:Name="SyncInfoDetailsValueText" Foreground="#1F2937" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#CCCCCC"/>

            <GroupBox x:Name="SyncTasksGroupBox" Grid.Row="2" Header="Sync Tasks" Padding="2">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,2,2,4">
                        <Button Content="Load Tasks" Click="ListTasks_Click" Margin="0,0,8,0" Width="80" Height="24"
                                Style="{StaticResource PrimaryButton}"/>
                        <Label Content="Limit:" VerticalAlignment="Center" Padding="0,0,4,0"/>
                        <TextBox x:Name="TaskListLimitInput" Width="50" Height="24" Margin="0,0,8,0" VerticalAlignment="Center" VerticalContentAlignment="Center" Text="50"/>
                    </StackPanel>
                    <Grid>
                        <TextBlock x:Name="SyncTasksEmptyText"
                                   Text="Click 'Load Tasks' to view tasks."
                                   Foreground="#888888" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Visible"/>
                        <ListView x:Name="SyncTasksGrid" Background="Transparent" BorderBrush="{x:Null}"
                                  AlternationCount="2"
                                  ItemContainerStyle="{StaticResource ZebraListViewItem}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}" Width="120"/>
                                    <GridViewColumn Header="EntityId" DisplayMemberBinding="{Binding EntityId}" Width="80"/>
                                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="70"/>
                                    <GridViewColumn Header="WorkflowType" DisplayMemberBinding="{Binding WorkflowType}" Width="110"/>
                                    <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="120"/>
                                    <GridViewColumn Header="ConfigId" DisplayMemberBinding="{Binding ConfigId}" Width="200"/>
                                    <GridViewColumn Header="CreateDate" DisplayMemberBinding="{Binding CreateDate}" Width="140"/>
                                    <GridViewColumn Header="Delete" Width="50">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Del" ToolTip="Delete this task"
                                                        Click="DeleteTaskButton_Click"
                                                        Style="{StaticResource DeleteActionButton}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Resubmit" Width="60">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Retry" ToolTip="Resubmit this task"
                                                        Click="ResubmitTaskButton_Click"
                                                        Style="{StaticResource ResubmitActionButton}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </DockPanel>
            </GroupBox>
        </Grid>

        <Border Grid.Row="2" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="8,3">
            <DockPanel>
                <TextBlock x:Name="ExtSyncSelectedItemText" DockPanel.Dock="Right" Foreground="#555555" FontSize="11" Margin="12,0,0,0"/>
                <TextBlock x:Name="ExtSyncStatusText" Foreground="#0696D7" FontSize="11"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
