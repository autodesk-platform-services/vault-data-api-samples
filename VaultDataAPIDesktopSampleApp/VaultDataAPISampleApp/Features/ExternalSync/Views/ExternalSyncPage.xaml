<Page x:Class="VaultDataAPISampleApp.Features.ExternalSync.Views.ExternalSyncPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:VaultDataAPISampleApp.Features.ExternalSync.Behaviors">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VaultDataAPISampleApp;component/Features/ExternalSync/Resources/ExternalSyncStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Vertical">
                <TextBlock Margin="0,0,0,6" FontSize="12" Text="{Binding HintText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#D13438"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasConfigs}" Value="True">
                                    <Setter Property="Foreground" Value="#107C10"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <DockPanel Margin="0,0,0,6">
                    <Button Content="Load Configs" Command="{Binding LoadConfigsCommand}" DockPanel.Dock="Left" Margin="0,0,8,0" Width="90" Height="26"
                            Style="{StaticResource PrimaryButton}"/>
                    <ProgressBar DockPanel.Dock="Left"
                                 Width="100"
                                 Height="5"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Visibility="{Binding LoadConfigsCommand.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBox Height="26" VerticalAlignment="Center" VerticalContentAlignment="Center"
                             Text="{Binding ConfigsText}" IsReadOnly="True" Background="#F5F5F5" FontFamily="Courier New" FontSize="11" Foreground="#444444"/>
                </DockPanel>
                <WrapPanel Orientation="Horizontal" IsEnabled="{Binding HasConfigs}">
                    <Button Content="Load Items" Command="{Binding LoadItemsCommand}" Margin="0,0,8,0" Width="90" Height="26"
                            Style="{StaticResource PrimaryButton}"/>
                    <Label Content="Limit:" VerticalAlignment="Center" Padding="0,0,4,0"/>
                    <TextBox Width="50" Height="26" Margin="0,0,8,0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                             Text="{Binding ItemLimit, UpdateSourceTrigger=PropertyChanged}"/>
                    <ProgressBar Width="100"
                                 Height="5"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Visibility="{Binding LoadItemsCommand.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="8,4,8,4" IsEnabled="{Binding HasConfigs}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasConfigs}" Value="True">
                            <Setter Property="Opacity" Value="1"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.3*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="2.7*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="Items" Padding="2">
                    <Grid>
                        <TextBlock Text="{Binding ItemsEmptyText}"
                                   Foreground="#888888" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ShowItemsEmptyText, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ListView Background="Transparent" BorderBrush="{x:Null}"
                                  SelectionMode="Extended"
                                  AlternationCount="2"
                                  ItemContainerStyle="{StaticResource ZebraListViewItem}"
                                  ItemsSource="{Binding Items}"
                                  SelectedItem="{Binding SelectedItem}"
                                  behaviors:ListViewSelectedItemsBehavior.SelectedItems="{Binding SelectedItems}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Number" DisplayMemberBinding="{Binding Number}" Width="160"/>
                                    <GridViewColumn Header="Revision" DisplayMemberBinding="{Binding Revision}" Width="55"/>
                                    <GridViewColumn Header="State" DisplayMemberBinding="{Binding State}" Width="100"/>
                                    <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}" Width="100"/>
                                    <GridViewColumn Header="Create Task" Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Create" ToolTip="Create Ext-Sync Task"
                                                        Command="{Binding DataContext.CreateTaskCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CreateActionButton}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </GroupBox>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#CCCCCC"/>

                <GroupBox Grid.Column="2" Padding="2">
                    <GroupBox.Header>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Sync Info" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right"
                                    Margin="8,0,0,0"
                                    ToolTip="Refresh selected item's sync info"
                                    Command="{Binding RefreshSelectedSyncInfoCommand}"
                                    Style="{StaticResource IconButton}">
                                <TextBlock
                                           Text="&#xE72C;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRefreshingSyncInfo}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="RefreshStoryboard">
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                                 From="0" To="360" Duration="0:0:0.9"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="RefreshStoryboard"/>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </DockPanel>
                    </GroupBox.Header>
                    <Grid>
                        <TextBlock Text="{Binding SyncInfoEmptyText}"
                                   Foreground="#888888" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ShowSyncInfoEmptyText, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Grid Visibility="{Binding HasSyncInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="10" CornerRadius="4" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="1"
                                    Visibility="{Binding HasStatusInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding StatusInfo.Name}" FontWeight="SemiBold" FontSize="15" Foreground="#1A1A1A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border BorderThickness="1" CornerRadius="10" Padding="8,2"
                                                    Visibility="{Binding StatusInfo.HasStatusBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E0E7FF"/>
                                                        <Setter Property="BorderBrush" Value="#818CF8"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusInfo.StatusBadgeText}" Value="Succeeded">
                                                                <Setter Property="Background" Value="#D1FAE5"/>
                                                                <Setter Property="BorderBrush" Value="#34D399"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusInfo.StatusBadgeText}" Value="Failed">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                                <Setter Property="BorderBrush" Value="#F87171"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusInfo.StatusBadgeText}" Value="PartiallySucceeded">
                                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                                <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusInfo.StatusBadgeText}" Value="Skipped">
                                                                <Setter Property="Background" Value="#E5E7EB"/>
                                                                <Setter Property="BorderBrush" Value="#9CA3AF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusInfo.StatusBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="#374151"/>
                                            </Border>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#F1F1F1" BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="10" Padding="8,2">
                                            <TextBlock Text="{Binding StatusInfo.CreateDateTime, StringFormat=Create: {0:G}, TargetNullValue=Create: -}" Foreground="#555555" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                    <Border Grid.Row="1" Background="#F6F8FB" BorderBrush="#E0E6EF" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="0,0,0,8" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding StatusInfo.ParentId, StringFormat=ParentId: {0}, TargetNullValue=ParentId: -}" Foreground="#4A5568" FontSize="11"/>
                                    </Border>
                                    <Border Grid.Row="2" Background="#F7F9FC" BorderBrush="#D9E0EA" BorderThickness="1" Padding="8" CornerRadius="3">
                                        <TextBlock Text="{Binding StatusInfo.DisplayValue}" Foreground="#1F2937" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Padding="10" CornerRadius="4" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="1"
                                    Visibility="{Binding HasDetailsInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DetailsInfo.Name}" Grid.Column="0" FontWeight="SemiBold" FontSize="15" Foreground="#1A1A1A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                        <Border Grid.Column="1" Background="#F1F1F1" BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="10" Padding="8,2">
                                            <TextBlock Text="{Binding DetailsInfo.CreateDateTime, StringFormat=Create: {0:G}, TargetNullValue=Create: -}" Foreground="#555555" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                    <Border Grid.Row="1" Background="#F6F8FB" BorderBrush="#E0E6EF" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="0,0,0,8" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding DetailsInfo.ParentId, StringFormat=ParentId: {0}, TargetNullValue=ParentId: -}" Foreground="#4A5568" FontSize="11"/>
                                    </Border>
                                    <Border Grid.Row="2" Background="#F7F9FC" BorderBrush="#D9E0EA" BorderThickness="1" Padding="8" CornerRadius="3">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <TextBlock Text="{Binding DetailsInfo.DisplayValue}" Foreground="#1F2937" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#CCCCCC"/>

            <GroupBox Grid.Row="2" Header="{Binding TasksHeader}" Padding="2">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,2,2,4">
                        <Button Content="Load Tasks" Command="{Binding LoadTasksCommand}" Margin="0,0,8,0" Width="80" Height="24"
                                Style="{StaticResource PrimaryButton}"/>
                        <Label Content="Limit:" VerticalAlignment="Center" Padding="0,0,4,0"/>
                        <TextBox Width="50" Height="24" Margin="0,0,8,0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 Text="{Binding TaskLimit, UpdateSourceTrigger=PropertyChanged}"/>
                        <ProgressBar Width="100"
                                     Height="5"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     IsIndeterminate="True"
                                     Visibility="{Binding LoadTasksCommand.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding TasksEmptyText}"
                                   Foreground="#888888" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ShowTasksEmptyText, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ListView Background="Transparent" BorderBrush="{x:Null}"
                                  AlternationCount="2"
                                  ItemsSource="{Binding Tasks}"
                                  ItemContainerStyle="{StaticResource ZebraListViewItem}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}" Width="120"/>
                                    <GridViewColumn Header="EntityId" DisplayMemberBinding="{Binding EntityId}" Width="80"/>
                                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="70"/>
                                    <GridViewColumn Header="WorkflowType" DisplayMemberBinding="{Binding WorkflowType}" Width="110"/>
                                    <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="120"/>
                                    <GridViewColumn Header="ConfigId" DisplayMemberBinding="{Binding ConfigId}" Width="200"/>
                                    <GridViewColumn Header="CreateDate" DisplayMemberBinding="{Binding CreateDate}" Width="140"/>
                                    <GridViewColumn Header="Delete" Width="50">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Del" ToolTip="Delete this task"
                                                        Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DeleteActionButton}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Resubmit" Width="60">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Retry" ToolTip="Resubmit this task"
                                                        Command="{Binding DataContext.ResubmitTaskCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ResubmitActionButton}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </DockPanel>
            </GroupBox>
        </Grid>

        <Border Grid.Row="2" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="8,3">
            <DockPanel>
                <TextBlock Text="{Binding SelectedItemText}" DockPanel.Dock="Right" Foreground="#555555" FontSize="11" Margin="12,0,0,0"/>
                <TextBlock Text="{Binding Status}" Foreground="#0696D7" FontSize="11"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
