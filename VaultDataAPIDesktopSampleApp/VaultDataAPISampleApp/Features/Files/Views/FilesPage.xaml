<Page x:Class="VaultDataAPISampleApp.Features.Files.Views.FilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Content="Total file count:"/>
        <Label Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Content="{Binding TotalCount}"/>
        <Button Grid.Row="0"
                Grid.Column="3"
                Panel.ZIndex="1"
                Margin="8,0,8,0"
                VerticalAlignment="Center"
                Command="{Binding LoadFilesCommand}"
                Content="Get Files"/>

        <Grid Grid.Row="1" Grid.ColumnSpan="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0"
                      ItemsSource="{Binding Files}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="200"/>
                        <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}" Width="100"/>
                        <GridViewColumn Header="State" DisplayMemberBinding="{Binding State}" Width="100"/>
                        <GridViewColumn Header="Revision" DisplayMemberBinding="{Binding Revision}" Width="100"/>
                        <GridViewColumn Header="Category" DisplayMemberBinding="{Binding Category}" Width="100"/>
                        <GridViewColumn Header="LastModifiedDate" DisplayMemberBinding="{Binding LastModifiedDate}" Width="100"/>
                        <GridViewColumn Header="CreateUserName" DisplayMemberBinding="{Binding CreateUserName}" Width="100"/>
                        <GridViewColumn Header="CheckinDate" DisplayMemberBinding="{Binding CheckinDate}" Width="100"/>
                        <GridViewColumn Header="Version" DisplayMemberBinding="{Binding Version}" Width="100"/>
                        <GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size}" Width="100"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <Grid Grid.Column="0"
                  Panel.ZIndex="1"
                  IsHitTestVisible="False"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Image Source="/Assets/Images/EmptyStateData.png" Stretch="None"/>
                <Label Margin="0,253,0,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Content="No data to display"
                       FontSize="24"/>
            </Grid>

            <Border Grid.Column="1"
                    Margin="0,0,0,0"
                    Background="{DynamicResource SeparatorBorderBrush}"/>

            <Grid Grid.Column="2" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0"
                       Content="Data Visualization"
                       FontWeight="Bold"/>
                <lvc:PieChart Grid.Row="1"
                              Background="{DynamicResource ListViewBackground}"
                              LegendPosition="Bottom"
                              Series="{Binding FileTypeSeries}"/>
                <Grid Grid.Row="1"
                      Panel.ZIndex="1"
                      IsHitTestVisible="False"
                      Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Image Source="/Assets/Images/EmptyStateCharts.png" Stretch="None"/>
                    <Label Margin="0,253,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Content="No charts to display"
                           FontSize="24"/>
                </Grid>
            </Grid>

            <Grid Grid.ColumnSpan="3"
                  Panel.ZIndex="2"
                  Background="{DynamicResource LayerFillColorDefaultBrush}"
                  Visibility="{Binding LoadFilesCommand.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,0,8"
                               HorizontalAlignment="Center"
                               Text="Loading files..."
                               FontSize="14"/>
                    <ProgressBar Width="240"
                                 Height="6"
                                 IsIndeterminate="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
