<Page x:Class="VaultDataAPISampleApp.Features.Users.Views.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Content="Total user count:"/>
        <Label Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Content="{Binding TotalCount}"/>
        <Button Grid.Row="0"
                Grid.Column="3"
                Panel.ZIndex="1"
                Margin="8,0,8,0"
                VerticalAlignment="Center"
                Command="{Binding LoadUsersCommand}"
                Content="Get Users"/>

        <Grid Grid.Row="1" Grid.ColumnSpan="4">
            <ListView ItemsSource="{Binding Users}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}" Width="100"/>
                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="200"/>
                        <GridViewColumn Header="Email" DisplayMemberBinding="{Binding Email}" Width="200"/>
                        <GridViewColumn Header="SystemName" DisplayMemberBinding="{Binding SystemName}" Width="200"/>
                        <GridViewColumn Header="AuthTypes" DisplayMemberBinding="{Binding AuthTypes}" Width="200"/>
                        <GridViewColumn Header="CreateDate" DisplayMemberBinding="{Binding CreateDate}" Width="200"/>
                        <GridViewColumn Header="IsActive" DisplayMemberBinding="{Binding IsActive}" Width="100"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <Grid Panel.ZIndex="1"
                  IsHitTestVisible="False"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Image Source="/Assets/Images/EmptyStateData.png" Stretch="None"/>
                <Label Margin="0,253,0,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Content="No data to display"
                       FontSize="24"/>
            </Grid>

            <Grid Panel.ZIndex="2"
                  Background="{DynamicResource LayerFillColorDefaultBrush}"
                  Visibility="{Binding LoadUsersCommand.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,0,8"
                               HorizontalAlignment="Center"
                               Text="Loading users..."
                               FontSize="14"/>
                    <ProgressBar Width="240"
                                 Height="6"
                                 IsIndeterminate="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
